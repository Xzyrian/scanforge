# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# virtual environment built by setup.bat
.venv/
venv/
env/

# ------------------------------------------------------------ build output
# both PyInstaller directories, and the zip build-exe.bat produces
build/
dist/
*.spec.bak
*.manifest
ScanForge-windows.zip

# the icon is drawn from code at build time, not checked in
scanforge.ico

# ------------------------------------------------------------- ScanForge
# Project files are the user's own work and belong wherever they keep their
# scans, not in the source tree.  These patterns catch the ones that get made
# while testing in place.
*.sfproj
*.sfproj.tmp

# Scans and exports: large, and never source.
*.tif
*.tiff
*.jp2
exports/
scans/

# The proxy cache normally lives under %LOCALAPPDATA%, but a run with that
# unset falls back to the home directory - and a stray one here would be
# hundreds of megabytes of JPEGs.
proxies/
.cache/

# --------------------------------------------------------------- test output
# The icon contact sheet is regenerated by tests/icon_sheet.py on demand.
tests/icon_sheet.png
tests/*.png
/tmp_test*/

# --------------------------------------------------------------------- misc
*.log
*.bak
*.orig
*.rej
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
